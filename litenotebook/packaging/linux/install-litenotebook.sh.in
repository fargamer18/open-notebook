#!/usr/bin/env bash
# LiteNotebook per-user installer for Linux x86_64.
#
# Generated by tools/build.py for ONE release: it installs only the archives
# named below, after checking their size and SHA-256. It needs no root and no
# network, never downloads anything and never runs files from the archives.
#
#   ./install-litenotebook.sh                 interactive
#   ./install-litenotebook.sh --yes [--with-embedding-runtime] [--prefix DIR]
#                             [--no-desktop-entry] [--desktop-shortcut]
#   ./install-litenotebook.sh --uninstall [--yes] [--prefix DIR]
#
# Put it in the same folder as the release archives (or run it from there).
# Your notebooks live in ~/.local/share/LiteNotebook and are never touched.

set -euo pipefail
umask 022

VERSION="@@VERSION@@"
CORE_FILE="@@CORE_FILE@@"
CORE_SIZE="@@CORE_SIZE@@"
CORE_SHA256="@@CORE_SHA256@@"
CORE_DIR="@@CORE_DIR@@"
RUNTIME_FILE="@@RUNTIME_FILE@@"
RUNTIME_SIZE="@@RUNTIME_SIZE@@"
RUNTIME_SHA256="@@RUNTIME_SHA256@@"
MARKER_LINE="# written by install-litenotebook.sh"
DESKTOP_MARKER="X-LiteNotebook-Installed-By=install-litenotebook.sh"
INFO=".litenotebook-install"

say() { printf '%s\n' "$*"; }
die() { printf 'Error: %s\n' "$*" >&2; exit 1; }

case "$VERSION" in *@@*) die "this is the installer template; use the install-litenotebook.sh from a release" ;; esac

xdg_dir() {  # an absolute XDG base directory, or the default
    local value="$1" fallback="$2"
    case "$value" in /*) printf '%s' "$value" ;; *) printf '%s' "$fallback" ;; esac
}
[ -n "${HOME:-}" ] && [ -d "$HOME" ] || die "HOME is not set to an existing folder"
DATA_HOME="$(xdg_dir "${XDG_DATA_HOME:-}" "$HOME/.local/share")"
STATE_HOME="$(xdg_dir "${XDG_STATE_HOME:-}" "$HOME/.local/state")"
PREFIX="$HOME/.local/opt/litenotebook"
BIN_DIR="$HOME/.local/bin"
APPS_DIR="$DATA_HOME/applications"
ICON_DIR="$DATA_HOME/icons/hicolor"
APP_DATA="$DATA_HOME/LiteNotebook"

MODE=install
ASSUME_YES=0
WITH_RUNTIME=""
MENU_ENTRY=1
DESKTOP_SHORTCUT=""

usage() {
    cat <<EOF
LiteNotebook $VERSION installer (per user, no root)

  --yes, -y                  do not ask; install with the defaults
  --with-embedding-runtime   also install the local semantic-search runtime
                             ($RUNTIME_FILE, ~1 GB installed)
  --prefix DIR               program folder (default: ~/.local/opt/litenotebook)
  --no-desktop-entry         do not add LiteNotebook to the application menu
  --desktop-shortcut         also put a shortcut on the desktop
  --uninstall                remove LiteNotebook (your notebooks are kept)
  --help                     this text
EOF
}

while [ $# -gt 0 ]; do
    case "$1" in
        -y|--yes) ASSUME_YES=1 ;;
        --with-embedding-runtime) WITH_RUNTIME=1 ;;
        --prefix) [ $# -ge 2 ] || die "--prefix needs a folder"; PREFIX="$2"; shift ;;
        --prefix=*) PREFIX="${1#--prefix=}" ;;
        --no-desktop-entry) MENU_ENTRY=0 ;;
        --desktop-shortcut) DESKTOP_SHORTCUT=1 ;;
        --uninstall) MODE=uninstall ;;
        -h|--help) usage; exit 0 ;;
        *) usage >&2; die "unknown option: $1" ;;
    esac
    shift
done

[ "$(id -u)" -ne 0 ] || die "run this as your normal user, without sudo: LiteNotebook installs for one user"
case "$PREFIX" in /*) ;; *) die "--prefix must be an absolute path" ;; esac
PREFIX="${PREFIX%/}"
case "$PREFIX" in ""|"$HOME"|"$HOME/.local"|"$DATA_HOME"|"$HOME/.local/opt") die "refusing to use $PREFIX as the program folder" ;; esac
case "$PREFIX/" in "$APP_DATA/"*) die "the program folder must not be inside your data folder ($APP_DATA)" ;; esac
case "$PREFIX" in *$'\n'*) die "the program folder name must not contain a line break" ;; esac

# --- helpers ---------------------------------------------------------------------

shq() {  # quote for /bin/sh
    printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"
}

desktop_exec() {  # quote an argument for a .desktop Exec key (spec: quoting, then string escapes)
    local s="$1"
    s="${s//\\/\\\\}"; s="${s//\"/\\\"}"; s="${s//\`/\\\`}"; s="${s//\$/\\\$}"
    s="\"$s\""
    s="${s//\\/\\\\}"
    s="${s//%/%%}"
    printf '%s' "$s"
}

ask() {  # ask "question" default(Y|N) -> 0 for yes
    local answer prompt="[y/N]"
    [ "$2" = Y ] && prompt="[Y/n]"
    printf '%s %s ' "$1" "$prompt"
    read -r answer || answer=""
    case "$answer" in
        [Yy]|[Yy][Ee][Ss]) return 0 ;;
        [Nn]|[Nn][Oo]) return 1 ;;
        "") [ "$2" = Y ] ;;
        *) [ "$2" = Y ] ;;
    esac
}

sha256_of() {
    if command -v sha256sum >/dev/null 2>&1; then sha256sum -- "$1" | cut -d' ' -f1
    elif command -v shasum >/dev/null 2>&1; then shasum -a 256 -- "$1" | cut -d' ' -f1
    else die "sha256sum is needed to verify the download"; fi
}

find_asset() {  # the release file next to this script, or in the current folder
    local name="$1" here
    here="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
    for dir in "$here" "$PWD"; do
        if [ -f "$dir/$name" ]; then printf '%s' "$dir/$name"; return 0; fi
    done
    return 1
}

verify_file() {  # path size sha256
    local actual
    actual="$(stat -c %s -- "$1" 2>/dev/null || wc -c <"$1")"
    [ "$actual" = "$2" ] || die "$(basename -- "$1") has the wrong size ($actual bytes, expected $2): incomplete or wrong download"
    actual="$(sha256_of "$1")"
    [ "$actual" = "$3" ] || die "$(basename -- "$1") does not match its SHA-256 checksum: do not install it"
}

check_archive() {  # archive top-folder: only plain files, folders and safe relative links under top-folder
    local archive="$1" top="$2" line name rest type target
    tar --version 2>/dev/null | head -n1 | grep -q 'GNU tar' || die "GNU tar is needed"
    while IFS= read -r name; do
        case "$name" in
            "$top"|"$top/"|"$top/"*) ;;
            *) die "unexpected entry in $(basename -- "$archive"): $name" ;;
        esac
        printf '%s' "$name" | grep -qE '^[A-Za-z0-9 ._+@,=~/-]+$' || die "unsafe file name in the archive: $name"
        case "/$name/" in */../*|*/./*) die "unsafe path in the archive: $name" ;; esac
    done < <(tar -tzf "$archive")
    while IFS= read -r line; do
        type="${line:0:1}"
        case "$type" in
            -|d) ;;
            l)
                rest="$(printf '%s' "$line" | sed -E 's/^([^ ]+ +){5}//')"
                target="${rest#* -> }"
                case "$target" in /*|..|../*|*/..|*/../*|"") die "unsafe link in the archive: $rest" ;; esac
                printf '%s' "$target" | grep -qE '^[A-Za-z0-9._+@,=~/-]+$' || die "unsafe link in the archive: $rest"
                ;;
            *) die "unsupported entry type in the archive: $line" ;;
        esac
    done < <(tar -tvzf "$archive")
}

running_from() {  # is a program from this folder running?
    local exe
    for exe in /proc/[0-9]*/exe; do
        case "$(readlink -- "$exe" 2>/dev/null || true)" in "$1"/*) return 0 ;; esac
    done
    return 1
}

read_info() {  # read_info folder key  (never sourced: values are paths)
    local key value
    [ -f "$1/$INFO" ] || return 1
    while IFS='=' read -r key value; do
        [ "$key" = "$2" ] && { printf '%s' "$value"; return 0; }
    done <"$1/$INFO"
    return 1
}

is_ours() {  # an installed file we wrote ourselves
    [ -f "$1" ] && grep -qF -- "$2" "$1"
}

desktop_dir() {
    local d=""
    if command -v xdg-user-dir >/dev/null 2>&1; then d="$(xdg-user-dir DESKTOP 2>/dev/null || true)"; fi
    if [ -n "$d" ] && [ "$d" != "$HOME" ] && [ -d "$d" ]; then printf '%s' "$d"; return 0; fi
    [ -d "$HOME/Desktop" ] && { printf '%s' "$HOME/Desktop"; return 0; }
    return 1
}

# --- uninstall ---------------------------------------------------------------------

if [ "$MODE" = uninstall ]; then
    [ -f "$PREFIX/$INFO" ] || die "no LiteNotebook installation found in $PREFIX"
    if [ "$ASSUME_YES" -ne 1 ]; then
        [ -t 0 ] || die "add --yes to uninstall without questions"
        say "This removes the LiteNotebook program from $PREFIX,"
        say "its launcher, menu entry and icon. Your notebooks are kept."
        ask "Uninstall LiteNotebook?" N || { say "Nothing was changed."; exit 0; }
    fi
    if running_from "$PREFIX"; then die "LiteNotebook is running. Quit it first (Settings → Diagnostics → Quit LiteNotebook)."; fi
    for key in launcher uninstaller; do
        f="$(read_info "$PREFIX" "$key" || true)"
        if [ -n "$f" ] && is_ours "$f" "$MARKER_LINE"; then rm -f -- "$f"; fi
    done
    for key in menu_entry desktop_shortcut; do
        f="$(read_info "$PREFIX" "$key" || true)"
        if [ -n "$f" ] && is_ours "$f" "$DESKTOP_MARKER"; then rm -f -- "$f"; fi
    done
    for key in icon_png icon_svg; do
        f="$(read_info "$PREFIX" "$key" || true)"
        case "$f" in */litenotebook.png|*/litenotebook.svg) rm -f -- "$f" ;; esac
    done
    data="$(read_info "$PREFIX" data_folder || printf '%s' "$APP_DATA")"
    rm -rf -- "$PREFIX"
    command -v update-desktop-database >/dev/null 2>&1 && update-desktop-database -q "$APPS_DIR" 2>/dev/null || true
    say "LiteNotebook was uninstalled."
    say ""
    say "Your notebooks, PDFs, notes, chats, backups, downloaded models and"
    say "AI components were kept in:"
    say "  $data"
    say "Logs are in: $STATE_HOME/LiteNotebook/logs"
    say "To remove them as well, delete those folders yourself (make a backup first)."
    exit 0
fi

# --- install -----------------------------------------------------------------------

CORE_PATH="$(find_asset "$CORE_FILE")" || die "$CORE_FILE was not found. Put it in the same folder as this installer."
RUNTIME_PATH=""
if [ -n "$RUNTIME_FILE" ]; then RUNTIME_PATH="$(find_asset "$RUNTIME_FILE" || true)"; fi
if [ "$WITH_RUNTIME" = 1 ] && [ -z "$RUNTIME_PATH" ]; then
    die "${RUNTIME_FILE:-the semantic-search runtime} was not found next to the installer"
fi
if [ -e "$PREFIX" ] && [ ! -f "$PREFIX/$INFO" ]; then
    die "$PREFIX already exists and is not a LiteNotebook installation; choose another --prefix"
fi
PREVIOUS="$(read_info "$PREFIX" version || true)"
PREVIOUS_RUNTIME="$(read_info "$PREFIX" runtime || true)"
KEEP_RUNTIME=0
if [ -z "$WITH_RUNTIME" ] && [ "$PREVIOUS_RUNTIME" = "$VERSION" ] && [ -d "$PREFIX/embedding-runtime" ]; then
    KEEP_RUNTIME=1  # same version already installed beside the app
fi

if [ "$ASSUME_YES" -ne 1 ]; then
    [ -t 0 ] || die "add --yes to install without questions (see --help)"
    say "LiteNotebook Installer"
    say ""
    say "Version: $VERSION${PREVIOUS:+ (replaces $PREVIOUS)}"
    say ""
    say "Install location:"
    say "  $PREFIX"
    say ""
    say "Components:"
    say "  [x] LiteNotebook"
    if [ -n "$RUNTIME_PATH" ]; then
        if [ "$KEEP_RUNTIME" = 1 ]; then
            say "  [x] Local semantic-search runtime (already installed; kept)"
        else
            say "  [ ] Local semantic-search runtime (~1 GB installed)"
            say "      Enables local embeddings and semantic search; needed to add new PDFs."
            if ask "      Install the semantic-search runtime?" N; then WITH_RUNTIME=1; fi
        fi
    else
        say "  [ ] Local semantic-search runtime: $RUNTIME_FILE was not found next to"
        say "      the installer. You can add it later in Settings → Local AI."
    fi
    say ""
    say "Desktop integration:"
    if ask "  Application menu shortcut?" Y; then MENU_ENTRY=1; else MENU_ENTRY=0; fi
    if ask "  Desktop shortcut?" N; then DESKTOP_SHORTCUT=1; fi
    say ""
    say "Your notebooks stay in $APP_DATA."
    ask "Install?" Y || { say "Nothing was changed."; exit 0; }
fi
if running_from "$PREFIX"; then die "LiteNotebook is running. Quit it first (Settings → Diagnostics → Quit LiteNotebook)."; fi

PARENT="$(dirname -- "$PREFIX")"
mkdir -p -- "$PARENT"
STAGE="$(mktemp -d "$PARENT/.litenotebook-stage.XXXXXX")"
OLD=""
cleanup() {
    [ -n "${STAGE:-}" ] && rm -rf -- "$STAGE"
    if [ -n "${OLD:-}" ] && [ -d "$OLD" ] && [ ! -e "$PREFIX" ]; then mv -- "$OLD" "$PREFIX"; fi
}
trap cleanup EXIT
trap 'exit 130' INT TERM

say ""
say "Verifying $CORE_FILE..."
verify_file "$CORE_PATH" "$CORE_SIZE" "$CORE_SHA256"
check_archive "$CORE_PATH" "$CORE_DIR"
if [ "$WITH_RUNTIME" = 1 ]; then
    say "Verifying $RUNTIME_FILE..."
    verify_file "$RUNTIME_PATH" "$RUNTIME_SIZE" "$RUNTIME_SHA256"
    check_archive "$RUNTIME_PATH" embedding-runtime
fi

say "Installing LiteNotebook..."
tar -xzf "$CORE_PATH" -C "$STAGE" --no-same-owner
APP="$STAGE/$CORE_DIR"
[ -f "$APP/litenotebook" ] && [ -x "$APP/litenotebook" ] && [ ! -L "$APP/litenotebook" ] || die "the archive has no litenotebook program"
grep -q "\"version\": \"$VERSION\"" "$APP/litenotebook-build.json" 2>/dev/null || die "the archive is not LiteNotebook $VERSION"

RUNTIME_STATE=none
if [ "$WITH_RUNTIME" = 1 ]; then
    say "Installing optional runtime..."
    mkdir -- "$STAGE/runtime"
    tar -xzf "$RUNTIME_PATH" -C "$STAGE/runtime" --no-same-owner
    [ -x "$STAGE/runtime/embedding-runtime/litenotebook-embed-worker" ] || die "the runtime archive has no worker program"
    mv -- "$STAGE/runtime/embedding-runtime" "$APP/embedding-runtime"
    RUNTIME_STATE="$VERSION"
elif [ "$KEEP_RUNTIME" = 1 ]; then
    say "Keeping the installed semantic-search runtime..."
    cp -al -- "$PREFIX/embedding-runtime" "$APP/embedding-runtime" 2>/dev/null \
        || cp -a -- "$PREFIX/embedding-runtime" "$APP/embedding-runtime"
    RUNTIME_STATE="$VERSION"
fi

LAUNCHER="$BIN_DIR/litenotebook"
UNINSTALLER="$BIN_DIR/litenotebook-uninstall"
MENU_FILE=""
[ "$MENU_ENTRY" = 1 ] && MENU_FILE="$APPS_DIR/litenotebook.desktop"
SHORTCUT=""
if [ "$DESKTOP_SHORTCUT" = 1 ]; then
    SHORTCUT_DIR="$(desktop_dir || true)"
    if [ -n "$SHORTCUT_DIR" ]; then SHORTCUT="$SHORTCUT_DIR/litenotebook.desktop"
    else say "No Desktop folder was found: skipping the desktop shortcut."; fi
fi
ICON_PNG="$ICON_DIR/256x256/apps/litenotebook.png"
ICON_SVG="$ICON_DIR/scalable/apps/litenotebook.svg"
for target in "$LAUNCHER" "$UNINSTALLER" "$MENU_FILE" "$SHORTCUT"; do
    [ -n "$target" ] && [ -e "$target" ] || continue
    is_ours "$target" "$MARKER_LINE" || is_ours "$target" "Name=LiteNotebook" \
        || die "$target exists and was not made by LiteNotebook; move it away first"
done
cp -- "${BASH_SOURCE[0]}" "$APP/install-litenotebook.sh"
chmod 755 "$APP/install-litenotebook.sh"
{
    printf 'version=%s\n' "$VERSION"
    printf 'runtime=%s\n' "$RUNTIME_STATE"
    printf 'launcher=%s\n' "$LAUNCHER"
    printf 'uninstaller=%s\n' "$UNINSTALLER"
    printf 'menu_entry=%s\n' "$MENU_FILE"
    printf 'desktop_shortcut=%s\n' "$SHORTCUT"
    printf 'icon_png=%s\n' "$ICON_PNG"
    printf 'icon_svg=%s\n' "$ICON_SVG"
    printf 'data_folder=%s\n' "$APP_DATA"
} >"$APP/$INFO"

say "Verifying files..."
[ -x "$APP/litenotebook" ] && [ -d "$APP/_internal" ] || die "the staged program is incomplete"

# replace: the old program folder is only removed once the new one is in place
if [ -e "$PREFIX" ]; then
    OLD="$(mktemp -d "$PARENT/.litenotebook-old.XXXXXX")"
    rmdir -- "$OLD"
    mv -- "$PREFIX" "$OLD"
fi
mv -- "$APP" "$PREFIX"
if [ -n "$OLD" ]; then rm -rf -- "$OLD"; OLD=""; fi

say "Installing desktop launcher..."
mkdir -p -- "$BIN_DIR"
{
    printf '#!/bin/sh\n%s\n' "$MARKER_LINE"
    printf 'exec %s "$@"\n' "$(shq "$PREFIX/litenotebook")"
} >"$LAUNCHER.tmp"
chmod 755 "$LAUNCHER.tmp"; mv -- "$LAUNCHER.tmp" "$LAUNCHER"
{
    printf '#!/bin/sh\n%s\n' "$MARKER_LINE"
    printf 'exec bash %s --uninstall --prefix %s "$@"\n' "$(shq "$PREFIX/install-litenotebook.sh")" "$(shq "$PREFIX")"
} >"$UNINSTALLER.tmp"
chmod 755 "$UNINSTALLER.tmp"; mv -- "$UNINSTALLER.tmp" "$UNINSTALLER"

say "Installing icon..."
mkdir -p -- "$(dirname -- "$ICON_PNG")" "$(dirname -- "$ICON_SVG")"
cp -- "$PREFIX/litenotebook.png" "$ICON_PNG"
cp -- "$PREFIX/litenotebook.svg" "$ICON_SVG"

write_desktop() {
    {
        printf '[Desktop Entry]\nType=Application\nName=LiteNotebook\n'
        printf 'GenericName=Notebook research assistant\n'
        printf 'Comment=Local notebook for your PDFs with source-grounded answers\n'
        printf 'Exec=%s\n' "$(desktop_exec "$PREFIX/litenotebook")"
        printf 'Icon=%s\n' "$ICON_PNG"
        printf 'Terminal=false\nCategories=Office;\nStartupNotify=true\n'
        printf '%s\n' "$DESKTOP_MARKER"
    } >"$1.tmp"
    chmod "$2" "$1.tmp"
    mv -- "$1.tmp" "$1"
}
if [ -n "$MENU_FILE" ]; then
    mkdir -p -- "$APPS_DIR"
    write_desktop "$MENU_FILE" 644
    command -v update-desktop-database >/dev/null 2>&1 && update-desktop-database -q "$APPS_DIR" 2>/dev/null || true
fi
if [ -n "$SHORTCUT" ]; then write_desktop "$SHORTCUT" 755; fi
# integration from an earlier install that was not chosen this time
OLD_MENU="$APPS_DIR/litenotebook.desktop"
if [ -z "$MENU_FILE" ] && is_ours "$OLD_MENU" "$DESKTOP_MARKER"; then rm -f -- "$OLD_MENU"; fi

trap - EXIT
rm -rf -- "$STAGE"

say ""
say "LiteNotebook $VERSION installed successfully."
say ""
say "Run:"
say "  litenotebook"
[ -n "$MENU_FILE" ] && say "or launch it from the application menu."
case ":$PATH:" in *":$BIN_DIR:"*) ;; *) say "(Add $BIN_DIR to your PATH, or run $(shq "$LAUNCHER").)" ;; esac
if [ "$RUNTIME_STATE" = none ]; then
    say ""
    say "Semantic search runtime: not installed. To index new PDFs, install it later"
    say "in Settings → Local AI, or run this installer again with --with-embedding-runtime."
fi
say ""
say "Your notebooks are stored in $APP_DATA."
say "Uninstall: litenotebook-uninstall (your notebooks are kept)."
